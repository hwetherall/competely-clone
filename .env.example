# =============================================================================
# Required API Keys
# =============================================================================

# Serper API for web search (required)
# Get your key at: https://serper.dev/
SERPER_API_KEY=your-serper-api-key-here

# Exa API for semantic discovery (optional; used by discovery rollout)
# Get your key at: https://dashboard.exa.ai/api-keys
# EXA_API_KEY=your-exa-api-key-here

# Atlas Cloud API for deprecated research models (optional rollback path)
# Get your key at: https://atlascloud.ai/
# ATLAS_CLOUD_API=your-atlascloud-api-key-here
# ATLAS_CLOUD_MODELS=Alibaba-NLP/Tongyi-DeepResearch-30B-A3B

# OpenRouter API for Claude research/synthesis models and fallback (required unless all configured models use direct providers)
# Get your key at: https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here

# xAI API for direct Grok fast-model calls (optional; enables direct routing for x-ai/* models)
# Get your key at: https://console.x.ai/
# XAI_API_KEY=xai-your-api-key-here
# XAI_BASE_URL=https://api.x.ai/v1

# Jina Reader API for extracting clean web page content (optional but recommended)
# Get your key at: https://jina.ai/reader/
# Note: Jina Reader works without an API key but has rate limits. With a key, you get higher limits.
JINA_READER_API_KEY=jina_your-api-key-here

# Firecrawl API for deep page extraction (optional; used by discovery rollout)
# Get your key at: https://www.firecrawl.dev/
# FIRECRAWL_API_KEY=your-firecrawl-api-key-here

# =============================================================================
# Model Configuration (optional - defaults shown)
# =============================================================================

# Primary research model (Claude Sonnet via OpenRouter)
# RESEARCH_MODEL=anthropic/claude-sonnet-4.6

# Fast model for summarization (direct xAI if XAI_API_KEY is set; otherwise OpenRouter)
# SUMMARIZE_MODEL=x-ai/grok-4.1-fast
# SUMMARIZE_FALLBACK_MODEL=anthropic/claude-sonnet-4.6

# Fast model for variable generation (direct xAI if XAI_API_KEY is set; otherwise OpenRouter)
# VARIABLE_GENERATOR_MODEL=x-ai/grok-4.1-fast
# VARIABLE_GENERATOR_FALLBACK_MODEL=anthropic/claude-sonnet-4.6

# Discovery model (via OpenRouter)
# DISCOVERY_MODEL=anthropic/claude-sonnet-4.6

# Maximum candidates returned by discovery
# DISCOVERY_MAX_CANDIDATES=20

# =============================================================================
# Evidence-Grounded Research (optional - defaults shown)
# =============================================================================

# Enable page fetching for full content extraction
# ENABLE_PAGE_FETCH=true

# Search provider for rollout experiments: serper, exa, or hybrid
# SEARCH_PROVIDER=serper
# EXA_BASE_URL=https://api.exa.ai
# EXA_SEARCH_TYPE=auto
# EXA_HIGHLIGHTS_MAX_CHARACTERS=4000
# EXA_TEXT_MAX_CHARACTERS=20000

# Number of top search results to fetch per query
# TOP_K_RESULTS_TO_FETCH=3

# Page reader for rollout experiments: jina or firecrawl
# PAGE_READER=jina
# FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2
# FIRECRAWL_TIMEOUT=60

# Maximum pages to fetch per research cell
# MAX_PAGES_PER_CELL=8

# Minimum source quality score (0.0 to 1.0)
# MIN_SOURCE_SCORE=0.35

# Number of passages to extract per source
# EVIDENCE_PASSAGES_PER_SOURCE=4

# Maximum total characters of evidence per cell
# MAX_EVIDENCE_CHARS=12000

# Enable LLM-based passage selection (slower but more accurate)
# ENABLE_LLM_PASSAGE_SELECTION=false

# Enable numeric verification against evidence
# ENABLE_NUMERIC_VERIFICATION=true

# Default max characters for concise summaries
# DEFAULT_MAX_CONCISE_CHARS=240

# =============================================================================
# Performance Tuning (optional - defaults shown)
# =============================================================================

# Enable caching of search and page results
# CACHE_ENABLED=true

# Maximum concurrent API requests
# MAX_CONCURRENT_REQUESTS=5

# Maximum concurrent page fetches
# MAX_CONCURRENT_PAGE_FETCHES=5

# Request timeout in seconds
# REQUEST_TIMEOUT=30

# LLM request timeout in seconds
# LLM_TIMEOUT=120

# Page fetch timeout in seconds
# PAGE_FETCH_TIMEOUT=15

# Maximum retry attempts
# MAX_RETRIES=3

# =============================================================================
# Research Configuration (optional - defaults shown)
# =============================================================================

# Maximum research iterations per cell
# MAX_RESEARCH_ITERATIONS=3

# Minimum iterations before checking sufficiency
# MIN_RESEARCH_ITERATIONS=2

# =============================================================================
# Deployment (production)
# =============================================================================
# Backend (e.g. Railway): comma-separated origins allowed by CORS.
# Include your Vercel frontend URL(s), e.g.:
# CORS_ORIGINS=https://your-app.vercel.app,https://your-app-*.vercel.app
# CORS_ORIGINS=

# Frontend (Vercel): set in Vercel project Environment Variables.
# Point to your deployed backend URL, e.g. https://your-api.up.railway.app
# NEXT_PUBLIC_API_URL=https://your-api.up.railway.app
