# =============================================================================
# Required API Keys
# =============================================================================

# Serper API for web search (required)
# Get your key at: https://serper.dev/
SERPER_API_KEY=your-serper-api-key-here

# Atlas Cloud API for Tongyi DeepResearch model (required for research)
# Get your key at: https://atlascloud.ai/
ATLAS_CLOUD_API=your-atlascloud-api-key-here

# OpenRouter API for fallback/summarization models (required)
# Get your key at: https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here

# Jina Reader API for extracting clean web page content (optional but recommended)
# Get your key at: https://jina.ai/reader/
# Note: Jina Reader works without an API key but has rate limits. With a key, you get higher limits.
JINA_READER_API_KEY=jina_your-api-key-here

# =============================================================================
# Model Configuration (optional - defaults shown)
# =============================================================================

# Primary research model (Tongyi DeepResearch via Atlas Cloud)
# RESEARCH_MODEL=Alibaba-NLP/Tongyi-DeepResearch-30B-A3B

# Fast model for summarization (via OpenRouter)
# SUMMARIZE_MODEL=deepseek/deepseek-v3.2

# =============================================================================
# Evidence-Grounded Research (optional - defaults shown)
# =============================================================================

# Enable page fetching for full content extraction
# ENABLE_PAGE_FETCH=true

# Number of top search results to fetch per query
# TOP_K_RESULTS_TO_FETCH=3

# Maximum pages to fetch per research cell
# MAX_PAGES_PER_CELL=8

# Minimum source quality score (0.0 to 1.0)
# MIN_SOURCE_SCORE=0.35

# Number of passages to extract per source
# EVIDENCE_PASSAGES_PER_SOURCE=4

# Maximum total characters of evidence per cell
# MAX_EVIDENCE_CHARS=12000

# Enable LLM-based passage selection (slower but more accurate)
# ENABLE_LLM_PASSAGE_SELECTION=false

# Enable numeric verification against evidence
# ENABLE_NUMERIC_VERIFICATION=true

# Default max characters for concise summaries
# DEFAULT_MAX_CONCISE_CHARS=240

# =============================================================================
# Performance Tuning (optional - defaults shown)
# =============================================================================

# Enable caching of search and page results
# CACHE_ENABLED=true

# Maximum concurrent API requests
# MAX_CONCURRENT_REQUESTS=5

# Maximum concurrent page fetches
# MAX_CONCURRENT_PAGE_FETCHES=5

# Request timeout in seconds
# REQUEST_TIMEOUT=30

# LLM request timeout in seconds
# LLM_TIMEOUT=120

# Page fetch timeout in seconds
# PAGE_FETCH_TIMEOUT=15

# Maximum retry attempts
# MAX_RETRIES=3

# =============================================================================
# Research Configuration (optional - defaults shown)
# =============================================================================

# Maximum research iterations per cell
# MAX_RESEARCH_ITERATIONS=3

# Minimum iterations before checking sufficiency
# MIN_RESEARCH_ITERATIONS=2
