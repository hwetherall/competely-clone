{
  "name": "competely-clone",
  "private": true,
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,magenta \"node scripts/start-backend.js\" \"cd frontend && npm run dev\"",
    "dev:backend": "node scripts/start-backend.js",
    "dev:backend:reload": "node scripts/start-backend.js --reload",
    "dev:frontend": "cd frontend && npm run dev"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0"
  }
}
